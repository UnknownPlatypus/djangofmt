<!-- Django: docs/internals/contributing/writing-code/coding-style.txt, template style -->
{% block header %}

  Code goes here

{% endblock header %}

<!-- Django: tests/template_tests/syntax_tests/test_partials.py::test_valid_partialdef_names, over several lines -->
{% partialdef 'space in name' %}
TEST with 'space in name'!
{% endpartialdef 'space in name' %}

<!-- Django: tests/template_tests/syntax_tests/test_named_endblock.py::namedendblocks01 -->
1{% block first %}_{% block second %}2{% endblock %}_{% endblock %}3

<!-- Django: tests/template_tests/syntax_tests/test_partials.py::inline_partial_explicit_end -->
{% partialdef testing-name inline %}HERE IS THE TEST CONTENT{% endpartialdef %}

<!-- Real-world: Misago misago/admin/templates/misago/admin/generic/form.html — a block in attribute position -->
<form role="form" method="post" {% block form-extra %}{% endblock %}></form>

<!-- A `custom-blocks` entry over several lines -->
{% stage dynamic %}
    {% load i18n %}
    {% translate "Appeler Hello Watt" %}
{% endstage dynamic %}

<!-- A `custom-blocks` entry on one line -->
<span>{% stage dynamic %}{{ csrf_token }}{% endstage %}</span>
