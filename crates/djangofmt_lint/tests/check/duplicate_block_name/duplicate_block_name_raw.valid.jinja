<!-- `{% raw %}` emits its body verbatim, so the blocks inside are text that can't clash with the one above -->
{% raw %}
{% block a %}{% endblock %}
{% block a %}{% endblock %}
<script>{% block a %}{% endblock %}</script>
{% endraw %}
<div {% raw %}{% block a %}x="1"{% endblock %}{% block a %}y="2"{% endblock %}{% endraw %}></div>
