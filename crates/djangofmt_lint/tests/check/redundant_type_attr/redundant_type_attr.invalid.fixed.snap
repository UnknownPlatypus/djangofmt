---
source: crates/djangofmt_lint/tests/check/main.rs
---
<!-- Redundant type on script -->
<script src="app.js"></script>

<!-- Redundant type on style -->
<style>.foo { color: red; }</style>

<!-- Case-insensitive tag name -->
<SCRIPT></SCRIPT>
<STYLE></STYLE>

<!-- Case-insensitive type value -->
<script></script>
<style></style>

<!-- Case-insensitive attribute name -->
<script></script>
<style></style>

<!-- Type attribute with other attributes -->
<script src="app.js" defer></script>

<!-- Multiline tag -->
<script
    src="app.js"
></script>

<!-- Single-quoted attribute -->
<script></script>

<!-- Unquoted attribute -->
<script></script>
<style></style>

<!-- Nested in Jinja block -->
{% if include_script %}
    <script src="app.js"></script>
{% endif %}

<!-- `text/css` is the default for a stylesheet link -->
<link rel="stylesheet" href="app.css">
<link rel="alternate stylesheet" href="print.css">
<link {% if print_styles %}rel="stylesheet"{% endif %} href="print.css">
