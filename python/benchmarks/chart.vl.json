{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "values": [
      {
        "tool": "Djangofmt",
        "time": 0.019,
        "timeFormat": "0.019s"
      },
      {
        "tool": "Djade",
        "time": 0.074,
        "timeFormat": "0.074s"
      },
      {
        "tool": "Djhtml",
        "time": 1.468,
        "timeFormat": "1.46s"
      },
      {
        "tool": "Djlint",
        "time": 2.155,
        "timeFormat": "2.15s"
      },
      {
        "tool": "Prettier",
        "time": 3.625,
        "timeFormat": "3.62s"
      }
    ]
  },
  "config": {
    "params": [
      {
        "name": "defaultFont",
        "value": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\""
      },
      {
        "name": "labelColor",
        "value": "#c9d1d9"
      },
      {
        "name": "barColor",
        "value": "#187f58"
      }
    ],
    "axis": {
      "labelColor": {
        "expr": "labelColor"
      },
      "labelFont": {
        "expr": "defaultFont"
      }
    },
    "view": {
      "stroke": null
    },
    "background": "transparent"
  },
  "background": "transparent",
  "encoding": {
    "y": {
      "field": "tool",
      "type": "nominal",
      "axis": {
        "grid": false,
        "title": null,
        "labelFontSize": 12,
        "ticks": false,
        "labelPadding": 10,
        "domain": false,
        "labelFontWeight": {
          "condition": {
            "test": "datum.value === 'Djangofmt'",
            "value": "bold"
          },
          "value": "normal"
        },
        "titleColor": {
          "expr": "labelColor"
        }
      },
      "sort": null
    },
    "x": {
      "field": "time",
      "type": "quantitative",
      "axis": {
        "title": null,
        "labelExpr": "datum.value + 's'",
        "tickCount": 3,
        "tickSize": 0,
        "labelPadding": 6,
        "labelAlign": "center",
        "labelFontSize": 12,
        "tickColor": "rgba(127,127,127,0.25)",
        "gridColor": "rgba(127,127,127,0.25)",
        "domain": false
      }
    }
  },
  "height": 120,
  "width": 420,
  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "size": {
          "value": 14
        },
        "color": {
          "value": {
            "expr": "barColor"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.tool !== 'Djangofmt'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "timeFormat"
        },
        "color": {
          "value": {
            "expr": "labelColor"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.tool === 'Djangofmt'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "timeFormat"
        },
        "color": {
          "value": {
            "expr": "labelColor"
          }
        }
      }
    }
  ]
}
