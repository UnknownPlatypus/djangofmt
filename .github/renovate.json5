{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  dependencyDashboard: {
    enabled: true,
  },
  suppressNotifications: [
    'prEditedNotification',
  ],
  extends: [
    'config:best-practices',
    'group:allNonMajor',
  ],
  labels: [
    'dependencies',
  ],
  schedule: [
    'before 4am on Monday',
  ],
  separateMajorMinor: false,
  minimumReleaseAge: '5 days',
  lockFileMaintenance: {
    enabled: false,
  },
  prHourlyLimit: 10,
  enabledManagers: [
    'github-actions',
    'cargo',
    'pep621',
    'npm',
    'deno',
    'custom.regex',
  ],
  cargo: {
    rangeStrategy: 'update-lockfile',
  },
  npm: {
    managerFilePatterns: [
      '/^python/.*package\\.json$/',
    ],
  },
  packageRules: [
    {
      groupName: 'Artifact GitHub Actions dependencies',
      matchManagers: [
        'github-actions',
        'custom.regex',
      ],
      matchDatasources: [
        'gitea-tags',
        'github-tags',
      ],
      matchPackageNames: [
        'actions/*-artifact',
      ],
      description: 'Weekly update of artifact-related GitHub Actions dependencies',
    },
    {
      groupName: 'GitHub runners',
      matchManagers: [
        'github-actions',
      ],
      matchDatasources: [
        'github-runners',
      ],
      description: "Disable PRs updating GitHub runners (e.g. 'runs-on: macos-14')",
      enabled: false,
    },
    {
      matchDepNames: [
        'markup_fmt',
      ],
      enabled: false,
      description: 'Disable updates for markup_fmt due to known issue',
    },
    {
      matchPackageNames: [
        'oxc-miette',
        'miette',
      ],
      enabled: false,
      description: 'Pin oxc-miette to 3.0.1, later versions dropped features we rely on',
    },
    {
      groupName: 'Rust toolchain and MSRV',
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'rust',
        'msrv',
      ],
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'msrv',
      ],
      minimumReleaseAge: '89 days',
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'msrv',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'maturin',
      ],
      commitMessageTopic: 'maturin',
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'cargo-dist',
      ],
      commitMessageTopic: 'cargo-dist',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+_VERSION: (?<currentValue>\\S+)(?:\\s+\\w+_CHECKSUM: (?<currentDigest>[a-f0-9]{64}))?',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/.github/workflows/release-build-binaries\\.yml$/',
      ],
      matchStrings: [
        'maturin-version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'maturin',
      packageNameTemplate: 'PyO3/maturin',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)Cargo\\.toml?$/',
      ],
      matchStrings: [
        'rust-version\\s*=\\s*"(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)"',
      ],
      depNameTemplate: 'msrv',
      packageNameTemplate: 'rust-lang/rust',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)rust-toolchain\\.toml?$/',
      ],
      matchStrings: [
        'channel\\s*=\\s*"(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)"',
      ],
      depNameTemplate: 'rust',
      packageNameTemplate: 'rust-lang/rust',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/.github/workflows/publish-playground-and-docs\\.yml$/',
      ],
      matchStrings: [
        'deno-version: "(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      depNameTemplate: 'deno',
      packageNameTemplate: 'denoland/deno',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^dprint\\.json$/',
      ],
      matchStrings: [
        '"https://plugins\\.dprint\\.dev/(?<depName>[a-z0-9_]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm"',
      ],
      packageNameTemplate: 'dprint/dprint-plugin-{{depName}}',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^dprint\\.json$/',
      ],
      matchStrings: [
        '"https://plugins\\.dprint\\.dev/g-plane/(?<depName>[a-z0-9_]+)-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.wasm"',
      ],
      packageNameTemplate: 'g-plane/{{depName}}',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)dist-workspace\\.toml$/',
      ],
      matchStrings: [
        'cargo-dist-version = "(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      depNameTemplate: 'cargo-dist',
      packageNameTemplate: 'astral-dev-toolchain-cargo-dist',
      datasourceTemplate: 'pypi',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        '(?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[A-Za-z0-9][\\w.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)dist-workspace\\.toml$/',
      ],
      matchStrings: [
        '"(?<depName>[\\w.-]+/[\\w.-]+)" = "(?<currentDigest>[a-f0-9]{40})"\\s+# (?<currentValue>v\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^(?<version>v?\\d+\\.\\d+\\.\\d+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.pre-commit-config\\.yaml$/',
      ],
      matchStrings: [
        '"github\\.com/github/gh-actions-lock/cmd/gh-actions-lock@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"',
      ],
      depNameTemplate: 'github/gh-actions-lock',
      datasourceTemplate: 'github-releases',
    },
  ],
  vulnerabilityAlerts: {
    commitMessageSuffix: '',
    labels: [
      'dependencies',
      'security',
    ],
  },
  osvVulnerabilityAlerts: true,
}
