---
import IconMinus from "./icons/IconMinus.astro";
import IconPlus from "./icons/IconPlus.astro";

interface Props {
  signalName: string;
  title: string;
  max: number;
}

const { signalName, title, max } = Astro.props;
---

<fieldset class="fieldset max-md:min-w-0 max-md:flex-1 max-md:max-w-24">
    <legend class="fieldset-legend max-md:py-1 text-xs font-bold text-base-content/90">
        {title}
    </legend>
    <label class="input input-sm w-full md:w-24 text-base-content/70 px-0 gap-0">
        <button
            class="text-xl cursor-pointer px-2 h-full rounded-l-field disabled:bg-base-content/10"
            data-on:click={`if ($${signalName} > 1) $${signalName}--`}
            data-attr:disabled={`$${signalName} == 1`}
        >
            <IconMinus />
        </button>
        <input
            type="number"
            class="text-center font-mono w-full"
            min="1"
            max={max}
            title={`Must be between 1 and ${max}`}
            data-bind={signalName}
            data-on:input={`if ($${signalName} < 1) $${signalName} = 1; else if ($${signalName} > ${max}) $${signalName} = ${max}`}
        >
        <button
            class="text-xl cursor-pointer px-2 h-full rounded-r-field disabled:bg-base-content/10"
            data-on:click={`if ($${signalName} < ${max}) $${signalName}++`}
            data-attr:disabled={`$${signalName} == ${max}`}
        >
            <IconPlus />
        </button>
    </label>
</fieldset>
