---
import BookIcon from "./icons/BookIcon.astro";
import BugIcon from "./icons/BugIcon.astro";
import DarkTheme from "./icons/DarkTheme.astro";
import IconMore from "./icons/IconMore.astro";
import IconShare from "./icons/IconShare.astro";
import LightTheme from "./icons/LightTheme.astro";
import PlusMinusInput from "./PlusMinusInput.astro";
---
<nav class="navbar bg-base-300 border-b border-base-300 min-h-0 px-3 py-1 flex justify-between gap-2 shrink-0 md:min-h-16 md:px-4 md:py-2 md:gap-8">
    <div class="flex items-center gap-2">
        <img
            src={`${import.meta.env.BASE_URL}android-chrome-192x192.png`}
            alt="djangofmt"
            width="32"
            height="32"
            class="h-8 w-8"
        >
        <span class="font-bold text-lg tracking-tight max-sm:hidden">djangofmt</span>
    </div>

    <div id="controls" class="flex items-end gap-2 max-md:min-w-0 max-md:flex-1 max-md:justify-center md:gap-8">
        <fieldset class="fieldset max-md:min-w-0 max-md:flex-1 max-md:max-w-24">
            <legend class="fieldset-legend max-md:py-1 text-xs font-bold text-base-content/90">
                Profile
            </legend>
            <select
                class="select select-sm w-full max-md:ps-2.5 max-md:pe-6 md:w-24 font-medium bg-base-100 text-base-content/70"
                data-bind="mode"
            >
                <option>Django</option>
                <option>Jinja</option>
            </select>
        </fieldset>
        <PlusMinusInput signalName="width" title="Line Length" max={320} />
        <PlusMinusInput signalName="indent" title="Indent" max={16} />
    </div>

    <div class="flex items-center gap-2">
        <a
            class="btn btn-sm btn-ghost text-base-content/60 tooltip tooltip-left text-sm max-md:hidden"
            data-tip="Open the documentation"
            href="https://unknownplatypus.github.io/djangofmt/docs/"
            target="_blank"
            rel="noopener noreferrer"
        >
            <BookIcon />
        </a>
        <button
            class="btn btn-sm btn-ghost text-base-content/60 tooltip tooltip-left text-sm max-md:hidden"
            data-tip="Report an issue on GitHub"
            data-on:click="openGithubIssue($inputCode, $mode, $width, $indent, monacoOutput.editor.getValue())"
        >
            <BugIcon />
        </button>
        <button
            class="btn btn-sm btn-ghost text-base-content/60 tooltip tooltip-left text-sm max-md:hidden"
            data-tip="Copy permalink"
            data-on:click="savePermalinkToClipboard($inputCode, $mode, $width, $indent)"
        >
            <IconShare />
        </button>
        <label
            class="swap swap-rotate btn btn-sm btn-circle btn-ghost text-base-content/60 max-[360px]:hidden md:tooltip md:tooltip-left"
            data-tip="Toggle theme"
        >
            <input type="checkbox" data-bind="lightTheme">
            <LightTheme />
            <DarkTheme />
        </label>
    </div>
    {/* Blur after an action so the speed dial closes (it is open while focus is inside). */}
    <div
        class="fab bottom-10 md:hidden"
        data-on:click="evt.target.closest('a, button') && document.activeElement.blur()"
    >
        <div tabindex="0" role="button" class="btn btn-circle btn-primary shadow-lg" aria-label="More actions">
            <IconMore />
        </div>
        <div>
            <span class="badge badge-neutral">Documentation</span>
            <a
                class="btn btn-circle shadow-lg"
                aria-label="Documentation"
                href="https://unknownplatypus.github.io/djangofmt/docs/"
                target="_blank"
                rel="noopener noreferrer"
            >
                <BookIcon />
            </a>
        </div>
        <div>
            <span class="badge badge-neutral">Report an issue</span>
            <button
                class="btn btn-circle shadow-lg"
                aria-label="Report an issue"
                data-on:click="openGithubIssue($inputCode, $mode, $width, $indent, monacoOutput.editor.getValue())"
            >
                <BugIcon />
            </button>
        </div>
        <div>
            <span class="badge badge-neutral">Copy permalink</span>
            <button
                class="btn btn-circle shadow-lg"
                aria-label="Copy permalink"
                data-on:click="savePermalinkToClipboard($inputCode, $mode, $width, $indent)"
            >
                <IconShare />
            </button>
        </div>
    </div>
</nav>
